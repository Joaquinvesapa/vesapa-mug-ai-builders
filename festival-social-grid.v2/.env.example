# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=festival
POSTGRES_PASSWORD=festival

DATABASE_URL=postgresql://festival:festival@localhost:5432/festival_dev
TEST_DATABASE_URL=postgresql://festival:festival@localhost:5432/festival_test

# Auth.js. Generate AUTH_SECRET with: openssl rand -base64 32
# It is also the PIN pepper: rotating it invalidates every PIN.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
